# ─────────────── Database ───────────────
# Lokal  : postgresql://postgres:PASSWORD@localhost:5432/sigap
# Supabase (dari laptop, untuk npm run setup / db:push / db:init) → pakai SESSION pooler (port 5432)
# Supabase (di Netlify)                                            → pakai TRANSACTION pooler (port 6543)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sigap"

# Lama sesi login (jam)
SESSION_TTL_HOURS=12

# Zona waktu operasional (dipakai untuk "hari ini", roster, dan laporan)
APP_TIMEZONE="Asia/Jakarta"

# Isi "true" bila aplikasi di belakang HTTPS tetapi proxy tidak mengirim header x-forwarded-proto
FORCE_SECURE_COOKIES="false"

# ─────────────── Penyimpanan foto (opsional di lokal, WAJIB di Netlify) ───────────────
# Kosongkan untuk menyimpan foto di folder storage/uploads (lokal).
# Isi untuk menyimpan di Supabase Storage (bucket harus Public).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="sigap-uploads"
